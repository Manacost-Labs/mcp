# Serve the paths below through the existing hearthpulse.net reverse proxy.
PUBLIC_URL=https://hearthpulse.net/mcp
HEARTHPULSE_URL=https://hearthpulse.net
HEARTHPULSE_LOGIN_URL=https://hearthpulse.net/?login
# Optional loopback origin for server-side session checks behind a public WAF.
HEARTHPULSE_INTERNAL_URL="" # configure locally
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=./data/mcp.sqlite
# Required: generate with `openssl rand -hex 32`; never commit the real value.
SESSION_ENCRYPTION_KEY="" # configure locally
KOLODA_URL=https://api.kolodahearthstone.com
# A service token with database:read, not an administrator token.
KOLODA_API_TOKEN="" # configure locally
HEARTHPULSE_API_KEY="" # configure locally
# Optional WordPress Application Passwords for full/private content.
MANACOST_WP_USERNAME="" # configure locally
MANACOST_WP_PASSWORD="" # configure locally
KOLODA_WP_USERNAME="" # configure locally
KOLODA_WP_API_URL="" # optional private loopback reader when Application Passwords are disabled
KOLODA_WP_PASSWORD="" # configure locally
OLD_KOLODA_WP_USERNAME="" # configure locally
OLD_KOLODA_WP_PASSWORD="" # configure locally
OLD_KOLODA_DATABASE_PATH="" # optional existing guides.sqlite opened read-only
INGEST_INTERVAL_SECONDS=900
WP_PAGES_PER_SYNC=10
HTML_PAGES_PER_SYNC=20
# Comma-separated numeric channel IDs, e.g. -1001234567890.
TELEGRAM_CHANNEL_IDS="" # configure locally
TELEGRAM_PUBLIC_CHANNELS="manacost_ru" # public archive; does not consume bot updates
# Secret shared with the existing bot's update-forwarding handler.
TELEGRAM_INGEST_SECRET="" # configure locally
# Existing Boosty API on this server: read-only analytics and post-sale summaries.
BOOSTY_LOCAL_URL=http://127.0.0.1:18082
BOOSTY_API_URL=https://api.boosty.to
BOOSTY_BLOG=kolodahearthstone
# Optional for full Boosty bodies; never read the existing service's session files.
BOOSTY_CONTENT_TOKEN="" # configure locally
BOOSTY_CONTENT_TOKEN_FILE="" # optional absolute path to the rotated access token
VK_COMMUNITY=manacost
VK_API_VERSION=5.199
VK_API_TOKEN="" # configure locally
# Read-only Stats API v2; allow only site IDs registered in your Plausible team.
PLAUSIBLE_URL=http://127.0.0.1:8000
PLAUSIBLE_DASHBOARD_URL=https://stats.hs-manacost.ru
PLAUSIBLE_SITE_IDS=hs-manacost.ru,kolodahearthstone.com,hearthpulse.net
PLAUSIBLE_API_KEY="" # separate stats:read:* key; never commit a real key
