{
  "name": "manacost-mcp",
  "version": "1.2.3",
  "description": "Admin-only HearthPulse MCP for Manacost websites, Telegram and the Koloda database",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "ingest": "tsx --env-file=.env src/ingest.ts",
    "import": "tsx --env-file=.env src/import.ts",
    "connect": "node scripts/connect.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manacost-Labs/mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Manacost-Labs/mcp/issues"
  },
  "homepage": "https://github.com/Manacost-Labs/mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
